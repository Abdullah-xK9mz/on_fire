{
  "rules": {
    ".read": true,
    ".write": "auth != null && (auth.token.email == 'admin@example.com' || !data.exists())",
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid || (auth != null && auth.token.email == 'admin@example.com')",
        ".write": "$uid === auth.uid || (auth != null && auth.token.email == 'admin@example.com')"
      }
    },
    "courses": { ".write": "auth != null && auth.token.email == 'admin@example.com'" },
    "teachers": { ".write": "auth != null && auth.token.email == 'admin@example.com'" },
    "settings": { ".write": "auth != null && auth.token.email == 'admin@example.com'" }
  }
}
